#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

export HOST_HOME="$HOME"

touch "$HOME/.claude.json"

compose_cmd() {
    local -a files=(-f "$SCRIPT_DIR/docker-compose.yml")
    for f in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
        [[ -e "$f" ]] && files+=(-f "$f")
    done
    docker compose "${files[@]}" "$@"
}

usage() {
    cat <<EOF
Usage: $(basename "$0") <command>

Commands:
  start       Start an interactive Claude Code session (--mount <path>)
  workspace   Manage named workspaces (list/create/switch/rm)
  build       Build all containers
  rebuild     Rebuild and restart (e.g. after allowlist changes)
  logs        Show tinyproxy logs (--blocked: show only denied requests)
  test        Run isolation verification tests
  stop        Stop all running containers
  status      Show container status
  exec <cmd>  Run a command in the Claude Code container
  shell       Start interactive bash in the Claude Code container
  allowlist   Manage the tinyproxy domain allowlist
  doctor      Run health diagnostics (proxy, DNS, connectivity)

Allowlist subcommands:
  allowlist [list]              List current allowlist entries with line numbers
  allowlist add <domain>        Add exact-match pattern for domain
  allowlist add --subdomains <domain>
                                Add subdomain-match pattern (base + all subdomains)
  allowlist remove <domain>     Remove all entries matching domain
  allowlist check <domain>      Exit 0 if domain matches allowlist, 1 if not
  allowlist profile save <name>    Save current allowlist as a named profile
  allowlist profile load <name>    Load a saved profile as the active allowlist
  allowlist profile list           List saved profiles
  allowlist profile rm <name>      Delete a saved profile
EOF
}

escape_domain() {
    printf '%s' "$1" | sed 's/\./\\./g'
}

require_domain() {
    local subcmd="$1" domain="$2"
    if [[ -z "$domain" ]]; then
        echo "Error: 'allowlist $subcmd' requires a domain argument" >&2
        exit 1
    fi
}

rebuild_reminder() {
    echo "Run ./hermit rebuild to apply changes"
}

case "${1:-}" in
    start)
        shift || true
        _mount_path=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --mount)
                    _mount_path="$2"
                    shift 2
                    ;;
                *)
                    echo "Error: unknown option '$1'" >&2
                    exit 1
                    ;;
            esac
        done
        _run_args=()
        if [[ -n "$_mount_path" ]]; then
            _abs_path="$(cd "$_mount_path" 2>/dev/null && pwd)" || {
                echo "Error: path '$_mount_path' does not exist" >&2
                exit 1
            }
            _run_args+=(-v "${_abs_path}:/home/node/workspace")
        elif [[ -f "$SCRIPT_DIR/.hermit-workspace" ]]; then
            _ws_name="$(cat "$SCRIPT_DIR/.hermit-workspace")"
            _run_args+=(-v "isolated-crustaion-${_ws_name}:/home/node/workspace")
        fi
        compose_cmd run --rm "${_run_args[@]+"${_run_args[@]}"}" claude-code
        ;;
    build)
        compose_cmd build
        ;;
    rebuild)
        compose_cmd build
        compose_cmd up -d tinyproxy
        ;;
    logs)
        shift
        _blocked=false
        _log_args=()
        for _arg in "$@"; do
            if [[ "$_arg" == "--blocked" ]]; then
                _blocked=true
            else
                _log_args+=("$_arg")
            fi
        done
        if [[ "$_blocked" == true ]]; then
            compose_cmd logs "${_log_args[@]+"${_log_args[@]}"}" tinyproxy | grep -iE 'refused|denied|blocked' || echo "(no blocked requests found)"
        else
            compose_cmd logs "${_log_args[@]+"${_log_args[@]}"}" tinyproxy
        fi
        ;;
    test)
        if ! command -v bats &>/dev/null; then
            echo "Error: bats-core not found. Install with: brew install bats-core" >&2
            exit 1
        fi
        compose_cmd up -d tinyproxy
        bats tests/
        ;;
    stop)
        compose_cmd down
        ;;
    status)
        compose_cmd ps
        ;;
    allowlist)
        shift
        # Parse optional --allowlist-file <path> flag
        _allowlist_file="$SCRIPT_DIR/tinyproxy/allowlist"
        _allowlist_args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --allowlist-file)
                    _allowlist_file="$2"
                    shift 2
                    ;;
                *)
                    _allowlist_args+=("$1")
                    shift
                    ;;
            esac
        done
        set -- "${_allowlist_args[@]+"${_allowlist_args[@]}"}"

        _subcmd="${1:-list}"
        case "$_subcmd" in
            list)
                cat -n "$_allowlist_file"
                ;;
            add)
                shift
                _subdomains=false
                if [[ "${1:-}" == "--subdomains" ]]; then
                    _subdomains=true
                    shift
                fi
                _domain="${1:-}"
                require_domain add "$_domain"
                _escaped="$(escape_domain "$_domain")"
                if [[ "$_subdomains" == true ]]; then
                    _pattern="^(.+\\.)?${_escaped}$"
                else
                    _pattern="^${_escaped}$"
                fi
                if grep -qF "$_pattern" "$_allowlist_file"; then
                    echo "Warning: '$_pattern' already exists in allowlist (duplicate skipped)"
                else
                    echo "$_pattern" >>"$_allowlist_file"
                    echo "Added: $_pattern"
                    rebuild_reminder
                fi
                ;;
            remove)
                shift
                _domain="${1:-}"
                require_domain remove "$_domain"
                _escaped="$(escape_domain "$_domain")"
                _exact="^${_escaped}$"
                _sub="^(.+\\.)?${_escaped}$"
                if ! grep -qF "$_exact" "$_allowlist_file" && ! grep -qF "$_sub" "$_allowlist_file"; then
                    echo "Error: no entry for '$_domain' found in allowlist" >&2
                    exit 1
                fi
                _tmpfile="$(mktemp)"
                grep -vF "$_exact" "$_allowlist_file" | grep -vF "$_sub" >"$_tmpfile"
                mv "$_tmpfile" "$_allowlist_file"
                echo "Removed entries for: $_domain"
                rebuild_reminder
                ;;
            check)
                shift
                _domain="${1:-}"
                require_domain check "$_domain"
                while IFS= read -r _line || [[ -n "$_line" ]]; do
                    [[ -z "$_line" ]] && continue
                    if [[ "$_domain" =~ $_line ]]; then
                        echo "MATCH: $_domain matches $_line"
                        exit 0
                    fi
                done <"$_allowlist_file"
                echo "NO MATCH: $_domain is not in allowlist"
                exit 1
                ;;
            profile)
                shift
                _profiles_dir="$(dirname "$_allowlist_file")/profiles"
                _prof_subcmd="${1:-list}"
                case "$_prof_subcmd" in
                    save)
                        shift
                        _prof_name="${1:-}"
                        if [[ -z "$_prof_name" ]]; then
                            echo "Error: 'allowlist profile save' requires a name" >&2
                            exit 1
                        fi
                        mkdir -p "$_profiles_dir"
                        cp "$_allowlist_file" "$_profiles_dir/$_prof_name"
                        echo "Saved profile: $_prof_name"
                        ;;
                    load)
                        shift
                        _prof_name="${1:-}"
                        if [[ -z "$_prof_name" ]]; then
                            echo "Error: 'allowlist profile load' requires a name" >&2
                            exit 1
                        fi
                        if [[ ! -f "$_profiles_dir/$_prof_name" ]]; then
                            echo "Error: profile '$_prof_name' not found" >&2
                            exit 1
                        fi
                        cp "$_profiles_dir/$_prof_name" "$_allowlist_file"
                        echo "Loaded profile: $_prof_name"
                        rebuild_reminder
                        ;;
                    list)
                        mkdir -p "$_profiles_dir"
                        if [[ -z "$(ls -A "$_profiles_dir" 2>/dev/null)" ]]; then
                            echo "No saved profiles"
                        else
                            ls -1 "$_profiles_dir"
                        fi
                        ;;
                    rm)
                        shift
                        _prof_name="${1:-}"
                        if [[ -z "$_prof_name" ]]; then
                            echo "Error: 'allowlist profile rm' requires a name" >&2
                            exit 1
                        fi
                        if [[ ! -f "$_profiles_dir/$_prof_name" ]]; then
                            echo "Error: profile '$_prof_name' not found" >&2
                            exit 1
                        fi
                        rm "$_profiles_dir/$_prof_name"
                        echo "Removed profile: $_prof_name"
                        ;;
                    *)
                        echo "Error: unknown profile subcommand '$_prof_subcmd'" >&2
                        echo "Usage: $(basename "$0") allowlist profile [save|load|list|rm] [name]" >&2
                        exit 1
                        ;;
                esac
                ;;
            *)
                echo "Error: unknown allowlist subcommand '$_subcmd'" >&2
                echo "Usage: $(basename "$0") allowlist [list|add|remove|check|profile] [options]" >&2
                exit 1
                ;;
        esac
        ;;
    exec)
        if [[ $# -lt 2 ]]; then
            echo "Error: 'exec' requires a command" >&2
            echo "Usage: $(basename "$0") exec <command>" >&2
            exit 1
        fi
        _cmd="$(printf '%q ' "${@:2}")"
        compose_cmd run --rm --no-deps -T --entrypoint bash claude-code -c "$_cmd"
        ;;
    shell)
        compose_cmd run --rm --no-deps --entrypoint bash claude-code
        ;;
    doctor)
        _pass=0
        _fail=0

        printf "%-40s" "Checking proxy container..."
        if compose_cmd ps tinyproxy 2>/dev/null | grep -q "running\|Up"; then
            echo "PASS"
            _pass=$((_pass + 1))
        else
            echo "FAIL (tinyproxy not running)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking DNS resolution..."
        if compose_cmd run --rm --no-deps -T --entrypoint bash claude-code -c "dig +short tinyproxy" 2>/dev/null | grep -q .; then
            echo "PASS"
            _pass=$((_pass + 1))
        else
            echo "FAIL (cannot resolve tinyproxy)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking allowed domain reachable..."
        _curl_fmt='%{http_code}'
        _http_code="$(compose_cmd run --rm --no-deps -T --entrypoint bash claude-code -c \
            "curl -s -o /dev/null -w '$_curl_fmt' --max-time 10 https://api.anthropic.com" 2>/dev/null || echo "000")"
        if [[ "$_http_code" != "000" ]]; then
            echo "PASS (HTTP $_http_code)"
            _pass=$((_pass + 1))
        else
            echo "FAIL (cannot reach api.anthropic.com)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking blocked domain denied..."
        _block_code="$(compose_cmd run --rm --no-deps -T --entrypoint bash claude-code -c \
            "curl -s -o /dev/null -w '$_curl_fmt' --max-time 10 https://google.com" 2>/dev/null || echo "000")"
        if [[ "$_block_code" == "403" ]] || [[ "$_block_code" == "000" ]]; then
            echo "PASS (HTTP $_block_code)"
            _pass=$((_pass + 1))
        else
            echo "FAIL (google.com returned HTTP $_block_code, expected 403)"
            _fail=$((_fail + 1))
        fi

        echo ""
        echo "Results: $_pass passed, $_fail failed"
        if [[ "$_fail" -gt 0 ]]; then
            exit 1
        fi
        ;;
    workspace)
        shift
        _ws_subcmd="${1:-list}"
        _vol_prefix="isolated-crustaion"
        case "$_ws_subcmd" in
            list)
                docker volume ls --filter "name=${_vol_prefix}" --format "table {{.Name}}\t{{.Driver}}\t{{.Mountpoint}}"
                ;;
            create)
                shift
                _ws_name="${1:-}"
                if [[ -z "$_ws_name" ]]; then
                    echo "Error: 'workspace create' requires a name" >&2
                    exit 1
                fi
                _full_name="${_vol_prefix}-${_ws_name}"
                if docker volume inspect "$_full_name" &>/dev/null; then
                    echo "Error: workspace '$_ws_name' already exists" >&2
                    exit 1
                fi
                docker volume create "$_full_name"
                echo "Created workspace: $_ws_name"
                ;;
            switch)
                shift
                _ws_name="${1:-}"
                if [[ -z "$_ws_name" ]]; then
                    echo "Error: 'workspace switch' requires a name" >&2
                    exit 1
                fi
                _full_name="${_vol_prefix}-${_ws_name}"
                if ! docker volume inspect "$_full_name" &>/dev/null; then
                    echo "Error: workspace '$_ws_name' does not exist" >&2
                    exit 1
                fi
                echo "$_ws_name" > "$SCRIPT_DIR/.hermit-workspace"
                echo "Switched to workspace: $_ws_name"
                ;;
            rm)
                shift
                _ws_name="${1:-}"
                if [[ -z "$_ws_name" ]]; then
                    echo "Error: 'workspace rm' requires a name" >&2
                    exit 1
                fi
                _full_name="${_vol_prefix}-${_ws_name}"
                if ! docker volume inspect "$_full_name" &>/dev/null; then
                    echo "Error: workspace '$_ws_name' does not exist" >&2
                    exit 1
                fi
                read -rp "Remove workspace '$_ws_name'? [y/N] " _confirm
                if [[ "$_confirm" =~ ^[Yy]$ ]]; then
                    docker volume rm "$_full_name"
                    echo "Removed workspace: $_ws_name"
                    if [[ -f "$SCRIPT_DIR/.hermit-workspace" ]] && [[ "$(cat "$SCRIPT_DIR/.hermit-workspace")" == "$_ws_name" ]]; then
                        rm "$SCRIPT_DIR/.hermit-workspace"
                    fi
                else
                    echo "Cancelled"
                fi
                ;;
            *)
                echo "Error: unknown workspace subcommand '$_ws_subcmd'" >&2
                echo "Usage: $(basename "$0") workspace [list|create|switch|rm] [name]" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        usage
        exit 1
        ;;
esac
