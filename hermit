#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

require_yq() {
    if ! command -v yq &>/dev/null; then
        echo "Error: yq is required (brew install yq)" >&2
        exit 1
    fi
}

require_sole_stack() {
    # Refuse to run if another hermit stack shares ic-internal network.
    # Get this checkout's compose project name and list containers on ic-internal
    # with a different project label. If foreign containers exist, print each one
    # with its working directory and exit 1.

    # Network might not exist yet; that's fine.
    if ! docker network inspect ic-internal &>/dev/null; then
        return 0
    fi

    local _this_project
    _this_project="$(compose_cmd config --format json 2>/dev/null | jq -r '.name')" || return 0

    # List containers on ic-internal with their labels
    local _containers
    _containers="$(docker ps --all --filter "network=ic-internal" \
        --format "{{.ID}}\t{{.Label \"com.docker.compose.project\"}}\t{{.Label \"com.docker.compose.project.working_dir\"}}\t{{.Names}}" 2>/dev/null)" || return 0

    local _has_foreign=false
    local _error_msg=""
    local _container_id _project _workdir _name

    while IFS=$'\t' read -r _container_id _project _workdir _name; do
        [[ -z "$_container_id" ]] && continue

        # Skip containers with the same project or no project label
        if [[ -z "$_project" ]]; then
            # Container with no compose project label - also a problem
            _error_msg="${_error_msg}Error: Found container on ic-internal with no project label: $_name (id: ${_container_id:0:12})"$'\n'
            _has_foreign=true
        elif [[ "$_project" != "$_this_project" ]]; then
            # Foreign project
            _error_msg="${_error_msg}Error: Found running container from project '$_project' on ic-internal (from: ${_workdir:-unknown})"$'\n'
            if [[ -d "$_workdir" ]]; then
                _error_msg="${_error_msg}  Stop it with: (cd ${_workdir} && ./hermit stop)"$'\n'
            else
                _error_msg="${_error_msg}  Working directory no longer exists; clean up with: docker rm -f $_name"$'\n'
            fi
            _has_foreign=true
        fi
    done <<<"$_containers"

    if [[ "$_has_foreign" == true ]]; then
        printf "%s" "$_error_msg" >&2
        return 1
    fi
    return 0
}

# Every command except usage/help ends up in compose_cmd or an MCP template
# read, both of which parse YAML with yq, so fail early with one clear message.
case "${1:-}" in
    ""|help|-h|--help) ;;
    *) require_yq ;;
esac

export HERMIT_CONFIG_DIR="${HERMIT_CONFIG_DIR:-$HOME/.hermit}"
mkdir -p "$HERMIT_CONFIG_DIR/claude"
if [[ ! -f "$HERMIT_CONFIG_DIR/claude.json" ]] || [[ ! -s "$HERMIT_CONFIG_DIR/claude.json" ]]; then
    echo '{}' > "$HERMIT_CONFIG_DIR/claude.json"
fi

# Workspace volume prefix constants
WS_PREFIX="isolated-crustacean"
WS_LEGACY_PREFIX="isolated-crustaion"

# Runtime compose override generated by hermit. It pins the workspace source
# (named volume or --mount bind path) for claude-code AND every enabled MCP
# service that mounts the workspace, so they always see the same files.
WS_OVERRIDE="$SCRIPT_DIR/mcp/.runtime/workspace.yml"

compose_cmd() {
    local -a files=(-f "$SCRIPT_DIR/docker-compose.yml")
    for f in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
        [[ -e "$f" ]] && files+=(-f "$f")
    done
    # Must come last so its volume definitions win the merge. A stale
    # override (mentions a service that is no longer enabled) would make
    # compose fail with "has neither an image nor a build context", so
    # re-derive it from the currently enabled set first.
    if [[ -e "$WS_OVERRIDE" ]]; then
        override_is_stale && refresh_workspace_override
        files+=(-f "$WS_OVERRIDE")
    fi
    docker compose "${files[@]}" "$@"
}

# True if the runtime override's service list no longer matches the enabled
# MCP set (e.g. mcp rm under HERMIT_NO_REBUILD=1, or a hand-deleted
# mcp/enabled/*.yml). NO_PROXY is always written as the full enabled list,
# so comparing it catches additions and removals alike.
override_is_stale() {
    local _recorded _expected=""
    _recorded="$(mcp_meta_key "$WS_OVERRIDE" 'services.claude-code.environment.NO_PROXY')"
    local _s
    while read -r _s; do
        [[ -n "$_s" ]] || continue
        _expected="${_expected:+$_expected,}$_s"
    done < <(enabled_mcp_services)
    [[ "$_recorded" != "$_expected" ]]
}

# Rewrite the override for the currently enabled services, keeping the
# workspace mode/source it already pins.
refresh_workspace_override() {
    local _ws_mode _ws_src
    read -r _ws_mode _ws_src < <(current_workspace_source)
    write_workspace_override "$_ws_mode" "$_ws_src"
}

# Print "mcp-<name>" for each enabled MCP server, one per line
enabled_mcp_services() {
    local _f
    for _f in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
        [[ -e "$_f" ]] || continue
        printf 'mcp-%s\n' "$(mcp_meta "$_f" name)"
    done
}

# Print "<service> <container-path>" for each enabled MCP service volume entry
# that mounts the shared `workspace` volume (e.g. "mcp-filesystem /data")
workspace_mounting_services() {
    local _f
    for _f in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
        [[ -e "$_f" ]] || continue
        yq -r '.services | to_entries[] | .key as $svc
               | (.value.volumes // [])[]
               | select(type == "!!str" and test("^workspace:"))
               | $svc + " " + (split(":")[1])' "$_f"
    done
}

# Print the workspace source currently pinned by the runtime override as
# "<mode> <source>" (mode is "volume" or "bind"). Falls back to the active
# named workspace when no override exists yet.
current_workspace_source() {
    local _mode="" _src=""
    if [[ -f "$WS_OVERRIDE" ]]; then
        _mode="$(mcp_meta_key "$WS_OVERRIDE" x-hermit.workspace_mode)"
        # yq already undoes the single-quote escaping ('' -> '); the value is
        # still compose-escaped ($$), so undo that to get the real path back
        _src="$(mcp_meta_key "$WS_OVERRIDE" x-hermit.workspace_source | sed 's/\$\$/$/g')"
    fi
    if [[ -z "$_mode" || -z "$_src" ]]; then
        _mode="volume"
        _src="$(workspace_volume)"
    fi
    printf '%s %s\n' "$_mode" "$_src"
}

# Write the runtime override for the given mode/source, covering claude-code
# and every enabled MCP service that mounts the workspace.
write_workspace_override() {
    local _mode="$1" _src="$2"
    # compose interpolates $VAR / ${VAR} everywhere in the file (a bind path
    # like "/tmp/my $HOME dir" would be rewritten); $$ is the literal escape.
    _src="${_src//\$/\$\$}"
    # Emitted as a YAML single-quoted scalar: no escape sequences are
    # interpreted (a path with " or \ stays literal); only ' needs doubling.
    _src="${_src//\'/\'\'}"
    mkdir -p "$(dirname "$WS_OVERRIDE")"
    local _tmp
    _tmp="$(mktemp)"
    # Claude must reach MCP servers directly, not via tinyproxy: tinyproxy
    # has no persistent-connection support and, after relaying a streamed
    # (SSE) response, blindly forwards the client's next keep-alive request
    # as raw proxy-form bytes, which the server rejects with 400. The
    # containers share ic-internal (no internet route), so NO_PROXY for the
    # mcp-* hostnames bypasses the proxy without widening egress.
    local _no_proxy=""
    local _s
    while read -r _s; do
        [[ -n "$_s" ]] || continue
        _no_proxy="${_no_proxy:+$_no_proxy,}$_s"
    done < <(enabled_mcp_services)
    {
        echo "# Generated by hermit - do not edit. Regenerated by 'hermit start' and"
        echo "# 'hermit mcp sync-workspace'. Pins the workspace source for claude-code"
        echo "# and enabled MCP services so they share the same files, and lets"
        echo "# claude-code reach enabled MCP servers directly (NO_PROXY)."
        echo "x-hermit:"
        echo "  workspace_mode: $_mode"
        echo "  workspace_source: '$_src'"
        echo "services:"
        echo "  claude-code:"
        echo "    environment:"
        echo "      NO_PROXY: \"$_no_proxy\""
        echo "      no_proxy: \"$_no_proxy\""
        if [[ "$_mode" == "volume" ]]; then
            # Every service references the shared 'workspace' key; renaming it
            # here repoints claude-code and all MCP services at once.
            echo "volumes:"
            echo "  workspace:"
            echo "    name: $_src"
        else
            # Bind mode: replace each service's named-volume entry (merged by
            # container path) with a bind mount of the same host path.
            echo "    volumes:"
            echo "      - type: bind"
            echo "        source: '$_src'"
            echo "        target: /home/node/workspace"
            local _svc _target
            while read -r _svc _target; do
                [[ -n "$_svc" ]] || continue
                echo "  $_svc:"
                echo "    volumes:"
                echo "      - type: bind"
                echo "        source: '$_src'"
                echo "        target: $_target"
            done < <(workspace_mounting_services)
        fi
    } > "$_tmp"
    chmod 0644 "$_tmp"
    mv "$_tmp" "$WS_OVERRIDE"
}

# Resolve --mount <path> (bind) or the active workspace (volume) and write the
# runtime override. Usage: sync_workspace_override [<mount-path>]
sync_workspace_override() {
    local _mount_path="${1:-}"
    if [[ -n "$_mount_path" ]]; then
        local _abs_path
        _abs_path="$(cd "$_mount_path" 2>/dev/null && pwd)" || {
            echo "Error: path '$_mount_path' does not exist" >&2
            exit 1
        }
        # Everything under --mount is writable from the container. Mounting
        # this checkout, a parent of it, or anything inside it would let a
        # compromised Claude rewrite hermit, the compose files, the allowlist
        # or mcp/enabled, i.e. run arbitrary code on the host at the next
        # hermit invocation.
        # Compare physical paths (pwd -P) so symlinks cannot dodge the check.
        local _mount_phys _self_phys
        _mount_phys="$(cd "$_abs_path" && pwd -P)"
        _self_phys="$(cd "$SCRIPT_DIR" && pwd -P)"
        if [[ "$_self_phys" == "$_mount_phys" \
            || "$_self_phys" == "${_mount_phys%/}/"* \
            || "$_mount_phys" == "${_self_phys}/"* ]]; then
            echo "Error: refusing to mount '$_abs_path': it is, contains, or is inside this hermit checkout ($_self_phys); a compromised container could rewrite hermit itself" >&2
            exit 1
        fi
        write_workspace_override bind "$_abs_path"
        echo "Workspace: bind mount $_abs_path"
    else
        local _ws_vol
        _ws_vol="$(workspace_volume)"
        write_workspace_override volume "$_ws_vol"
        echo "Workspace: volume $_ws_vol"
    fi
}

# Bring up tinyproxy plus enabled MCP services (never claude-code, which is
# only ever started via 'compose run'). Recreates containers whose config
# changed, e.g. after the workspace override was rewritten. --wait blocks
# until the MCP healthchecks pass so Claude connects to listening servers.
mcp_services_up() {
    local -a _svcs=(tinyproxy)
    local _s
    while read -r _s; do
        [[ -n "$_s" ]] && _svcs+=("$_s")
    done < <(enabled_mcp_services)
    compose_cmd up -d --wait --wait-timeout 90 "${_svcs[@]}"
}

# Build the image for every MCP template (each template is a valid standalone
# compose file), so 'mcp add' and the test-suite find images ready. Template
# build contexts are relative to the repo root (compose resolves them against
# the project directory, i.e. the first -f file's dir, when loaded via
# compose_cmd), so pin the project directory here as well.
build_mcp_images() {
    local _tmpl
    for _tmpl in "$SCRIPT_DIR"/mcp/templates/*.yml; do
        [[ -e "$_tmpl" ]] || continue
        yq -e '.services[] | has("build")' "$_tmpl" &>/dev/null || continue
        docker compose -p ic-mcp-build --project-directory "$SCRIPT_DIR" -f "$_tmpl" build
    done
}

# Read a scalar at a dotted yq path from a YAML file (empty if absent)
mcp_meta_key() {
    local file="$1" path="$2"
    require_yq
    local val
    val="$(yq -r ".${path} // \"\"" "$file")"
    [[ "$val" == "null" ]] && val=""
    printf '%s' "$val"
}

mcp_meta() {
    local file="$1" key="$2"
    mcp_meta_key "$file" "x-mcp.${key}"
}

ws_volume() {
    local _name="$1"
    local _new_vol="${WS_PREFIX}-${_name}"
    local _legacy_vol="${WS_LEGACY_PREFIX}-${_name}"

    if docker volume inspect "$_new_vol" &>/dev/null; then
        printf '%s\n' "$_new_vol"
    elif docker volume inspect "$_legacy_vol" &>/dev/null; then
        printf '%s\n' "$_legacy_vol"
        echo "Note: using legacy workspace volume '$_legacy_vol' (created before the prefix rename)" >&2
    else
        printf '%s\n' "$_new_vol"
    fi
}

workspace_volume() {
    if [[ -f "$SCRIPT_DIR/.hermit-workspace" ]]; then
        local _ws_name
        _ws_name="$(cat "$SCRIPT_DIR/.hermit-workspace")"
        validate_name "$_ws_name" "workspace name"
        ws_volume "$_ws_name"
    else
        printf '%s\n' "ic-workspace"
    fi
}

usage() {
    cat <<EOF
Usage: $(basename "$0") <command>

Commands:
  start       Start an interactive Claude Code session (--mount <path>)
  workspace   Manage named workspaces (list/create/switch/rm)
  build       Build all containers
  rebuild     Rebuild and restart (e.g. after allowlist changes)
  logs        Show tinyproxy logs (--blocked: show only denied requests)
  test        Run isolation verification tests
  stop        Stop all running containers
  status      Show container status
  exec <cmd>  Run a command in the Claude Code container
  shell       Start interactive bash in the Claude Code container
  allowlist   Manage the tinyproxy domain allowlist
  doctor      Run health diagnostics (proxy, DNS, connectivity)
  mcp         Manage MCP servers (list/add/rm/status/restart)

MCP subcommands:
  mcp list                    List available MCP servers and their status
  mcp add <name>              Enable an MCP server (auto-rebuilds)
  mcp rm <name>               Disable an MCP server (auto-rebuilds)
  mcp status                  Show running MCP server containers
  mcp restart                 Restart MCP server containers
  mcp sync-workspace [--mount <path>]
                              Regenerate the runtime workspace override

Workspace subcommands:
  workspace [list]            List all workspaces
  workspace create <name>     Create a new workspace
  workspace switch <name>     Switch to a workspace
  workspace rm <name>         Remove a workspace
  workspace current           Show the currently active workspace volume

Allowlist subcommands:
  allowlist [list]              List current allowlist entries with line numbers
  allowlist add <domain>        Add exact-match pattern for domain
  allowlist add --subdomains <domain>
                                Add subdomain-match pattern (base + all subdomains)
  allowlist remove <domain>     Remove all entries matching domain
  allowlist check <domain>      Exit 0 if domain matches allowlist, 1 if not
  allowlist profile save <name>    Save current allowlist as a named profile
  allowlist profile load <name>    Load a saved profile as the active allowlist
  allowlist profile list           List saved profiles
  allowlist profile rm <name>      Delete a saved profile
EOF
}

escape_domain() {
    printf '%s' "$1" | sed 's/\./\\./g'
}

require_domain() {
    local subcmd="$1" domain="$2"
    if [[ -z "$domain" ]]; then
        echo "Error: 'allowlist $subcmd' requires a domain argument" >&2
        exit 1
    fi
}

rebuild_reminder() {
    echo "Run ./hermit rebuild to apply changes"
}

validate_name() {
    local _name="$1" _label="$2"
    if [[ ! "$_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Error: $_label '$_name' must contain only letters, numbers, hyphens, and underscores" >&2
        exit 1
    fi
}

case "${1:-}" in
    start)
        require_sole_stack
        shift || true
        _mount_path=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --mount)
                    _mount_path="$2"
                    shift 2
                    ;;
                *)
                    echo "Error: unknown option '$1'" >&2
                    exit 1
                    ;;
            esac
        done
        # The runtime override pins the workspace source for claude-code and
        # every enabled MCP service, so no -v is needed on the run itself.
        sync_workspace_override "$_mount_path"
        mcp_services_up || {
            echo "Error: an MCP service failed to start or pass its healthcheck. Inspect with './hermit mcp status' and './hermit logs', or disable it with './hermit mcp rm <name>'" >&2
            exit 1
        }
        compose_cmd run --rm claude-code
        ;;
    build)
        compose_cmd --profile probe build
        build_mcp_images
        ;;
    rebuild)
        require_sole_stack
        compose_cmd --profile probe build
        build_mcp_images
        mcp_services_up
        ;;
    logs)
        shift
        _blocked=false
        _log_args=()
        for _arg in "$@"; do
            if [[ "$_arg" == "--blocked" ]]; then
                _blocked=true
            else
                _log_args+=("$_arg")
            fi
        done
        if [[ "$_blocked" == true ]]; then
            compose_cmd logs "${_log_args[@]+"${_log_args[@]}"}" tinyproxy | grep -iE 'refused|denied|blocked' || echo "(no blocked requests found)"
        else
            compose_cmd logs "${_log_args[@]+"${_log_args[@]}"}" tinyproxy
        fi
        ;;
    test)
        require_sole_stack
        if ! command -v bats &>/dev/null; then
            echo "Error: bats-core not found. Install with: brew install bats-core" >&2
            exit 1
        fi
        compose_cmd up -d tinyproxy
        bats tests/
        ;;
    stop)
        compose_cmd down
        ;;
    status)
        compose_cmd ps
        ;;
    allowlist)
        shift
        # Parse optional --allowlist-file <path> flag
        _allowlist_file="$SCRIPT_DIR/tinyproxy/allowlist"
        _allowlist_args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --allowlist-file)
                    _allowlist_file="$2"
                    shift 2
                    ;;
                *)
                    _allowlist_args+=("$1")
                    shift
                    ;;
            esac
        done
        set -- "${_allowlist_args[@]+"${_allowlist_args[@]}"}"

        _subcmd="${1:-list}"
        case "$_subcmd" in
            list)
                cat -n "$_allowlist_file"
                ;;
            add)
                shift
                _subdomains=false
                if [[ "${1:-}" == "--subdomains" ]]; then
                    _subdomains=true
                    shift
                fi
                _domain="${1:-}"
                require_domain add "$_domain"
                _escaped="$(escape_domain "$_domain")"
                if [[ "$_subdomains" == true ]]; then
                    _pattern="^(.+\\.)?${_escaped}$"
                else
                    _pattern="^${_escaped}$"
                fi
                if grep -qF "$_pattern" "$_allowlist_file"; then
                    echo "Warning: '$_pattern' already exists in allowlist (duplicate skipped)"
                else
                    echo "$_pattern" >>"$_allowlist_file"
                    echo "Added: $_pattern"
                    rebuild_reminder
                fi
                ;;
            remove)
                shift
                _domain="${1:-}"
                require_domain remove "$_domain"
                _escaped="$(escape_domain "$_domain")"
                _exact="^${_escaped}$"
                _sub="^(.+\\.)?${_escaped}$"
                if ! grep -qF "$_exact" "$_allowlist_file" && ! grep -qF "$_sub" "$_allowlist_file"; then
                    echo "Error: no entry for '$_domain' found in allowlist" >&2
                    exit 1
                fi
                _tmpfile="$(mktemp)"
                grep -vF "$_exact" "$_allowlist_file" | grep -vF "$_sub" >"$_tmpfile"
                # mktemp creates 0600; the file is COPY'd into the tinyproxy
                # image and must stay readable by the 'nobody' user
                chmod 0644 "$_tmpfile"
                mv "$_tmpfile" "$_allowlist_file"
                echo "Removed entries for: $_domain"
                rebuild_reminder
                ;;
            check)
                shift
                _domain="${1:-}"
                require_domain check "$_domain"
                while IFS= read -r _line || [[ -n "$_line" ]]; do
                    [[ -z "$_line" ]] && continue
                    if [[ "$_domain" =~ $_line ]]; then
                        echo "MATCH: $_domain matches $_line"
                        exit 0
                    fi
                done <"$_allowlist_file"
                echo "NO MATCH: $_domain is not in allowlist"
                exit 1
                ;;
            profile)
                shift
                _profiles_dir="$(dirname "$_allowlist_file")/profiles"
                _prof_subcmd="${1:-list}"
                case "$_prof_subcmd" in
                    save)
                        shift
                        _prof_name="${1:-}"
                        if [[ -z "$_prof_name" ]]; then
                            echo "Error: 'allowlist profile save' requires a name" >&2
                            exit 1
                        fi
                        validate_name "$_prof_name" "profile name"
                        mkdir -p "$_profiles_dir"
                        cp "$_allowlist_file" "$_profiles_dir/$_prof_name"
                        echo "Saved profile: $_prof_name"
                        ;;
                    load)
                        shift
                        _prof_name="${1:-}"
                        if [[ -z "$_prof_name" ]]; then
                            echo "Error: 'allowlist profile load' requires a name" >&2
                            exit 1
                        fi
                        validate_name "$_prof_name" "profile name"
                        if [[ ! -f "$_profiles_dir/$_prof_name" ]]; then
                            echo "Error: profile '$_prof_name' not found" >&2
                            exit 1
                        fi
                        cp "$_profiles_dir/$_prof_name" "$_allowlist_file"
                        echo "Loaded profile: $_prof_name"
                        rebuild_reminder
                        ;;
                    list)
                        mkdir -p "$_profiles_dir"
                        if [[ -z "$(ls -A "$_profiles_dir" 2>/dev/null)" ]]; then
                            echo "No saved profiles"
                        else
                            ls -1 "$_profiles_dir"
                        fi
                        ;;
                    rm)
                        shift
                        _prof_name="${1:-}"
                        if [[ -z "$_prof_name" ]]; then
                            echo "Error: 'allowlist profile rm' requires a name" >&2
                            exit 1
                        fi
                        validate_name "$_prof_name" "profile name"
                        if [[ ! -f "$_profiles_dir/$_prof_name" ]]; then
                            echo "Error: profile '$_prof_name' not found" >&2
                            exit 1
                        fi
                        rm "$_profiles_dir/$_prof_name"
                        echo "Removed profile: $_prof_name"
                        ;;
                    *)
                        echo "Error: unknown profile subcommand '$_prof_subcmd'" >&2
                        echo "Usage: $(basename "$0") allowlist profile [save|load|list|rm] [name]" >&2
                        exit 1
                        ;;
                esac
                ;;
            *)
                echo "Error: unknown allowlist subcommand '$_subcmd'" >&2
                echo "Usage: $(basename "$0") allowlist [list|add|remove|check|profile] [options]" >&2
                exit 1
                ;;
        esac
        ;;
    exec)
        require_sole_stack
        if [[ $# -lt 2 ]]; then
            echo "Error: 'exec' requires a command" >&2
            echo "Usage: $(basename "$0") exec <command>" >&2
            exit 1
        fi
        _cmd="$(printf '%q ' "${@:2}")"
        compose_cmd run --rm --no-deps -T --entrypoint bash claude-code -c "$_cmd"
        ;;
    shell)
        require_sole_stack
        compose_cmd run --rm --no-deps --entrypoint bash claude-code
        ;;
    doctor)
        _pass=0
        _fail=0

        printf "%-40s" "Checking yq installed..."
        if command -v yq &>/dev/null; then
            echo "PASS"
            _pass=$((_pass + 1))
        else
            echo "FAIL (yq not found; hermit requires it: brew install yq)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking for other hermit stacks..."
        _stack_err=""
        if ! _stack_err=$(require_sole_stack 2>&1); then
            echo "FAIL"
            _fail=$((_fail + 1))
            echo "$_stack_err" >&2
        else
            echo "PASS"
            _pass=$((_pass + 1))
        fi

        printf "%-40s" "Checking proxy container..."
        if compose_cmd ps tinyproxy 2>/dev/null | grep -q "running\|Up"; then
            echo "PASS"
            _pass=$((_pass + 1))
        else
            echo "FAIL (tinyproxy not running)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking DNS resolution..."
        if compose_cmd --profile probe run --rm --no-deps -T --entrypoint bash probe -c "dig +short tinyproxy" 2>/dev/null | grep -q .; then
            echo "PASS"
            _pass=$((_pass + 1))
        else
            echo "FAIL (cannot resolve tinyproxy)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking allowed domain reachable..."
        _curl_fmt='%{http_code}'
        _http_code="$(compose_cmd --profile probe run --rm --no-deps -T --entrypoint bash probe -c \
            "curl -s -o /dev/null -w '$_curl_fmt' --max-time 10 https://api.anthropic.com" 2>/dev/null)" || true
        _http_code="${_http_code:-000}"
        if [[ "$_http_code" != "000" ]]; then
            echo "PASS (HTTP $_http_code)"
            _pass=$((_pass + 1))
        else
            # tinyproxy only accepts clients from RFC1918 ranges (Allow lines
            # in tinyproxy.conf); print the subnet so a mismatch is obvious.
            _internal_subnet="$(docker network inspect ic-internal \
                --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null || true)"
            echo "FAIL (cannot reach api.anthropic.com; ic-internal subnet ${_internal_subnet:-unknown} must be within an Allow range in tinyproxy/tinyproxy.conf)"
            _fail=$((_fail + 1))
        fi

        printf "%-40s" "Checking blocked domain denied..."
        _block_code="$(compose_cmd --profile probe run --rm --no-deps -T --entrypoint bash probe -c \
            "curl -s -o /dev/null -w '%{http_connect}' --max-time 10 https://google.com" 2>/dev/null)" || true
        _block_code="${_block_code:-000}"
        if [[ "$_block_code" == "403" ]]; then
            echo "PASS (HTTP CONNECT $_block_code)"
            _pass=$((_pass + 1))
        else
            echo "FAIL (google.com returned HTTP CONNECT $_block_code, expected 403)"
            _fail=$((_fail + 1))
        fi

        for _enabled in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
            [[ -e "$_enabled" ]] || continue
            _mcp_name=$(mcp_meta "$_enabled" name)
            _al_pattern="^mcp-${_mcp_name}$"

            printf "%-40s" "MCP allowlist: mcp-${_mcp_name}..."
            if grep -qF "$_al_pattern" "$SCRIPT_DIR/tinyproxy/allowlist"; then
                echo "PASS"
                _pass=$((_pass + 1))
            else
                echo "FAIL (missing allowlist entry)"
                _fail=$((_fail + 1))
            fi

            printf "%-40s" "MCP config: ${_mcp_name}..."
            if jq -e --arg name "$_mcp_name" \
                '.mcpServers[$name] | (.type == "http") and ((.url // "") | length > 0)' \
                "$HERMIT_CONFIG_DIR/claude.json" &>/dev/null; then
                echo "PASS"
                _pass=$((_pass + 1))
            else
                echo "FAIL (missing from .claude.json or not type http)"
                _fail=$((_fail + 1))
            fi
        done

        echo ""
        echo "Results: $_pass passed, $_fail failed"
        if [[ "$_fail" -gt 0 ]]; then
            exit 1
        fi
        ;;
    workspace)
        shift
        _ws_subcmd="${1:-list}"
        case "$_ws_subcmd" in
            list)
                docker volume ls --filter "name=^${WS_PREFIX}-" --filter "name=^${WS_LEGACY_PREFIX}-" --format "table {{.Name}}\t{{.Driver}}\t{{.Mountpoint}}"
                ;;
            create)
                shift
                _ws_name="${1:-}"
                if [[ -z "$_ws_name" ]]; then
                    echo "Error: 'workspace create' requires a name" >&2
                    exit 1
                fi
                validate_name "$_ws_name" "workspace name"
                _new_vol="${WS_PREFIX}-${_ws_name}"
                _legacy_vol="${WS_LEGACY_PREFIX}-${_ws_name}"
                if docker volume inspect "$_new_vol" &>/dev/null || docker volume inspect "$_legacy_vol" &>/dev/null; then
                    echo "Error: workspace '$_ws_name' already exists" >&2
                    exit 1
                fi
                docker volume create "$_new_vol"
                echo "Created workspace: $_ws_name"
                ;;
            switch)
                shift
                _ws_name="${1:-}"
                if [[ -z "$_ws_name" ]]; then
                    echo "Error: 'workspace switch' requires a name" >&2
                    exit 1
                fi
                validate_name "$_ws_name" "workspace name"
                _vol="$(ws_volume "$_ws_name")"
                if ! docker volume inspect "$_vol" &>/dev/null; then
                    echo "Error: workspace '$_ws_name' does not exist" >&2
                    exit 1
                fi
                echo "$_ws_name" > "$SCRIPT_DIR/.hermit-workspace"
                echo "Switched to workspace: $_ws_name"
                # The runtime override pins whatever workspace was active when
                # it was written; repin it so exec/shell/MCP follow the switch.
                if [[ -e "$WS_OVERRIDE" ]]; then
                    sync_workspace_override
                fi
                ;;
            rm)
                shift
                _ws_name="${1:-}"
                if [[ -z "$_ws_name" ]]; then
                    echo "Error: 'workspace rm' requires a name" >&2
                    exit 1
                fi
                validate_name "$_ws_name" "workspace name"
                _vol="$(ws_volume "$_ws_name")"
                if ! docker volume inspect "$_vol" &>/dev/null; then
                    echo "Error: workspace '$_ws_name' does not exist" >&2
                    exit 1
                fi
                read -rp "Remove workspace '$_ws_name'? [y/N] " _confirm
                if [[ "$_confirm" =~ ^[Yy]$ ]]; then
                    docker volume rm "$_vol"
                    echo "Removed workspace: $_ws_name"
                    if [[ -f "$SCRIPT_DIR/.hermit-workspace" ]] && [[ "$(cat "$SCRIPT_DIR/.hermit-workspace")" == "$_ws_name" ]]; then
                        rm "$SCRIPT_DIR/.hermit-workspace"
                        # Active workspace is gone: repin the override to the
                        # default volume instead of leaving it on a removed one
                        if [[ -e "$WS_OVERRIDE" ]]; then
                            sync_workspace_override
                        fi
                    fi
                else
                    echo "Cancelled"
                fi
                ;;
            current)
                workspace_volume
                ;;
            *)
                echo "Error: unknown workspace subcommand '$_ws_subcmd'" >&2
                echo "Usage: $(basename "$0") workspace [list|create|switch|rm|current] [name]" >&2
                exit 1
                ;;
        esac
        ;;
    mcp)
        shift
        _mcp_subcmd="${1:-}"
        case "$_mcp_subcmd" in
            add)
                require_sole_stack
                shift
                _mcp_name="${1:-}"
                if [[ -z "$_mcp_name" ]]; then
                    echo "Error: 'mcp add' requires a server name" >&2
                    exit 1
                fi
                validate_name "$_mcp_name" "MCP server name"
                _tmpl="$SCRIPT_DIR/mcp/templates/${_mcp_name}.yml"
                if [[ ! -f "$_tmpl" ]]; then
                    echo "Error: template '$_mcp_name' not found in mcp/templates/" >&2
                    exit 1
                fi
                _enabled="$SCRIPT_DIR/mcp/enabled/${_mcp_name}.yml"
                if [[ -f "$_enabled" ]]; then
                    echo "MCP server '$_mcp_name' is already enabled"
                    exit 0
                fi
                _mcp_port=$(mcp_meta "$_tmpl" port)
                _mcp_path=$(mcp_meta "$_tmpl" path)
                _mcp_url="http://mcp-${_mcp_name}:${_mcp_port}${_mcp_path}"
                cp "$_tmpl" "$_enabled"
                _al_pattern="^mcp-${_mcp_name}$"
                if ! grep -qF "$_al_pattern" "$SCRIPT_DIR/tinyproxy/allowlist"; then
                    echo "$_al_pattern" >> "$SCRIPT_DIR/tinyproxy/allowlist"
                fi
                _claude_json="$HERMIT_CONFIG_DIR/claude.json"
                if [[ ! -s "$_claude_json" ]]; then
                    echo '{}' > "$_claude_json"
                fi
                _tmp_json="$(mktemp)"
                # Claude Code skips url-only entries ("has a url but no type"); the
                # Streamable HTTP transport is registered as type "http".
                jq --arg name "$_mcp_name" --arg url "$_mcp_url" \
                    '.mcpServers[$name] = {"type": "http", "url": $url}' "$_claude_json" > "$_tmp_json"
                mv "$_tmp_json" "$_claude_json"
                echo "Enabled MCP server: $_mcp_name ($_mcp_url)"
                _req_env="$(mcp_meta "$_tmpl" requires_env)"
                if [[ -n "$_req_env" && -z "${!_req_env:-}" ]]; then
                    echo "Warning: $_req_env is not set in your environment; '$_mcp_name' will start but its tool calls will fail until you export it and run ./hermit mcp restart" >&2
                fi
                # Re-pin the workspace override with the current source so the
                # new service mounts what claude-code is (or will be) using.
                # Always done (it is only a file write): a stale override that
                # mentions a service that is no longer enabled breaks compose.
                refresh_workspace_override
                if [[ "${HERMIT_NO_REBUILD:-}" != "1" ]]; then
                    # tinyproxy bakes the allowlist into its image, so it must be
                    # rebuilt (and recreated by up) for ^mcp-<name>$ to take effect.
                    compose_cmd build tinyproxy "mcp-${_mcp_name}"
                    mcp_services_up
                fi
                ;;
            rm)
                require_sole_stack
                shift
                _mcp_name="${1:-}"
                if [[ -z "$_mcp_name" ]]; then
                    echo "Error: 'mcp rm' requires a server name" >&2
                    exit 1
                fi
                _enabled="$SCRIPT_DIR/mcp/enabled/${_mcp_name}.yml"
                if [[ ! -f "$_enabled" ]]; then
                    echo "Error: MCP server '$_mcp_name' is not enabled" >&2
                    exit 1
                fi
                if [[ "${HERMIT_NO_REBUILD:-}" != "1" ]]; then
                    # Stop and remove the container while its compose file is
                    # still loaded; afterwards compose no longer knows about it.
                    compose_cmd rm -sf "mcp-${_mcp_name}"
                fi
                rm "$_enabled"
                _al_pattern="^mcp-${_mcp_name}$"
                _tmpfile="$(mktemp)"
                grep -vF "$_al_pattern" "$SCRIPT_DIR/tinyproxy/allowlist" > "$_tmpfile" || true
                # mktemp creates 0600; keep the allowlist readable by tinyproxy's
                # 'nobody' user once it is COPY'd into the image
                chmod 0644 "$_tmpfile"
                mv "$_tmpfile" "$SCRIPT_DIR/tinyproxy/allowlist"
                _claude_json="$HERMIT_CONFIG_DIR/claude.json"
                if [[ -s "$_claude_json" ]]; then
                    _tmp_json="$(mktemp)"
                    jq --arg name "$_mcp_name" 'del(.mcpServers[$name])' "$_claude_json" > "$_tmp_json"
                    mv "$_tmp_json" "$_claude_json"
                fi
                echo "Disabled MCP server: $_mcp_name"
                # Always prune the removed service from the override (file write
                # only); otherwise every later compose_cmd fails on it.
                refresh_workspace_override
                if [[ "${HERMIT_NO_REBUILD:-}" != "1" ]]; then
                    # Rebuild tinyproxy so the removed allowlist entry is gone
                    compose_cmd build tinyproxy
                    mcp_services_up
                fi
                ;;
            sync-workspace)
                shift
                _mount_path=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --mount)
                            _mount_path="${2:-}"
                            if [[ -z "$_mount_path" ]]; then
                                echo "Error: --mount requires a path" >&2
                                exit 1
                            fi
                            shift 2
                            ;;
                        *)
                            echo "Error: unknown option '$1'" >&2
                            exit 1
                            ;;
                    esac
                done
                sync_workspace_override "$_mount_path"
                echo "Wrote $WS_OVERRIDE"
                ;;
            status)
                _has_enabled=false
                for _f in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
                    [[ -e "$_f" ]] && _has_enabled=true && break
                done
                if [[ "$_has_enabled" == false ]]; then
                    echo "No MCP servers enabled"
                    exit 0
                fi
                compose_cmd ps --filter "name=mcp-"
                ;;
            restart)
                require_sole_stack
                _has_enabled=false
                for _f in "$SCRIPT_DIR"/mcp/enabled/*.yml; do
                    [[ -e "$_f" ]] && _has_enabled=true && break
                done
                if [[ "$_has_enabled" == false ]]; then
                    echo "No MCP servers enabled"
                    exit 0
                fi
                compose_cmd restart
                ;;
            list)
                printf "%-15s %-10s %s\n" "NAME" "STATUS" "DESCRIPTION"
                for _tmpl in "$SCRIPT_DIR"/mcp/templates/*.yml; do
                    [[ -e "$_tmpl" ]] || continue
                    _name=$(mcp_meta "$_tmpl" name)
                    _desc=$(mcp_meta "$_tmpl" description)
                    if [[ -f "$SCRIPT_DIR/mcp/enabled/${_name}.yml" ]]; then
                        _status="enabled"
                    else
                        _status="disabled"
                    fi
                    printf "%-15s %-10s %s\n" "$_name" "$_status" "$_desc"
                done
                ;;
            ""|help)
                cat <<MCPEOF
Usage: $(basename "$0") mcp <subcommand>

Subcommands:
  list                    List available MCP servers and their status
  add <name>              Enable an MCP server (auto-rebuilds)
  rm <name>               Disable an MCP server (auto-rebuilds)
  status                  Show running MCP server containers
  restart                 Restart MCP server containers
  sync-workspace [--mount <path>]
                          Regenerate mcp/.runtime/workspace.yml so MCP servers
                          mount the active workspace (or the given host path)
MCPEOF
                ;;
            *)
                echo "Error: unknown mcp subcommand '$_mcp_subcmd'" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        usage
        exit 1
        ;;
esac
